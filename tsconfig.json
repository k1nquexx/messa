{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "client/**/*.js",
    "server/server.js",
    "test_*.js"
  ],
  "exclude": [
    "node_modules",
    "desktop",
    "mobile"
  ]
}
