<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Messa.Mobile"
             x:Class="Messa.Mobile.MainPage"
             BackgroundColor="#0E121A">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="14">
        <!-- Top Header -->
        <Border Grid.Row="0" BackgroundColor="#161C26" StrokeThickness="0" Padding="12" Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="🛡️ MESSA Native Mobile" FontSize="18" FontAttributes="Bold" TextColor="#4A90E2"/>
                    <Label x:Name="StatusLabel" Text="Disconnected" FontSize="12" TextColor="#7A889B"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="ConnectBtn" Text="Connect" Clicked="OnConnectClicked" BackgroundColor="#2B5278" TextColor="White" HeightRequest="36" Padding="12,0"/>
            </Grid>
        </Border>

        <!-- Identity Section -->
        <Border Grid.Row="1" BackgroundColor="#161C26" StrokeThickness="0" Padding="12" Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6">
                <Label Text="My Device Fingerprint:" FontSize="11" TextColor="#8899A6" FontAttributes="Bold"/>
                <Label x:Name="MyFingerprintLabel" FontSize="11" TextColor="#64B5F6" LineBreakMode="MiddleTruncation" FontFamily="Monospace"/>
            </VerticalStackLayout>
        </Border>

        <!-- Chat List -->
        <Border Grid.Row="2" BackgroundColor="#161C26" StrokeThickness="0" Padding="8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <CollectionView x:Name="MessagesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:MobileChatMessage">
                        <Border BackgroundColor="{Binding BackgroundColor}" StrokeThickness="0" Padding="10" Margin="4" HorizontalOptions="{Binding Alignment}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Header}" FontSize="10" FontAttributes="Bold" TextColor="#8899A6"/>
                                <Label Text="{Binding Text}" FontSize="14" TextColor="White" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding Time}" FontSize="9" TextColor="#657786" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Input Bar -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
            <Entry Grid.Column="0" x:Name="MessageInput" Placeholder="Type encrypted message..." PlaceholderColor="#657786" TextColor="White" BackgroundColor="#161C26" HeightRequest="45"/>
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" BackgroundColor="#4A90E2" TextColor="White" FontAttributes="Bold" HeightRequest="45" Margin="8,0,0,0"/>
        </Grid>
    </Grid>

</ContentPage>
