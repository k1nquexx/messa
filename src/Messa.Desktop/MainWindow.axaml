<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Messa.Desktop"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="Messa.Desktop.MainWindow"
        Title="MESSA - Sovereign Native Messenger"
        Width="950" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#0E121A">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <!-- Header -->
        <Border Grid.Row="0" Background="#161C26" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ MESSA" FontSize="20" FontWeight="Bold" Foreground="#4A90E2"/>
                    <TextBlock Text="Native Skia E2EE" FontSize="13" VerticalAlignment="Center" Foreground="#7A889B"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF4D4D"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#7A889B" VerticalAlignment="Center"/>
                    <TextBox x:Name="ServerUrlBox" Text="wss://fotowaqu.ru" Width="200" VerticalAlignment="Center"/>
                    <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnectClicked" Background="#2B5278" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Identity Bar -->
        <Border Grid.Row="1" Background="#161C26" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Text="My ID:" FontWeight="SemiBold" Foreground="#A0AAB8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="MyFingerprintBox" IsReadOnly="True" Background="#0E121A" Foreground="#64B5F6" FontFamily="Consolas, monospace" FontSize="12"/>
                <Button Grid.Column="2" Content="Copy ID" Click="OnCopyIdClicked" Margin="10,0,0,0" Background="#232C3A" Foreground="#E0E6ED"/>
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Border Grid.Row="2" Background="#161C26" CornerRadius="10" Padding="14">
            <Grid RowDefinitions="Auto, *">
                <!-- Recipient Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, *" Margin="0,0,0,10">
                    <TextBlock Text="Recipient ID:" VerticalAlignment="Center" Foreground="#A0AAB8" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="RecipientIdBox" Watermark="Enter recipient fingerprint" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="2" Text="Public Key:" VerticalAlignment="Center" Foreground="#A0AAB8" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="3" x:Name="RecipientPubKeyBox" Watermark="Base64 ECDH Public Key"/>
                </Grid>

                <!-- Message List -->
                <ListBox Grid.Row="1" x:Name="MessagesList" Background="#0E121A" CornerRadius="8" Padding="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ChatMessage">
                            <Border Background="{Binding BackgroundColor}" CornerRadius="8" Padding="10" Margin="4,4,4,4" MaxWidth="600" HorizontalAlignment="{Binding Alignment}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Header}" FontSize="11" Foreground="#8899A6" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Text}" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#657786" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Input Bar -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,14,0,0">
            <TextBox Grid.Column="0" x:Name="MessageInputBox" Watermark="Type an encrypted message..." Height="42" VerticalContentAlignment="Center" KeyDown="OnMessageInputKeyDown"/>
            <Button Grid.Column="1" Content="Send Encrypted" Click="OnSendClicked" Background="#4A90E2" Foreground="White" FontWeight="Bold" Margin="10,0,0,0" Height="42" Padding="20,0"/>
        </Grid>
    </Grid>
</Window>
