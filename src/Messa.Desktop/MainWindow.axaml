<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Messa.Desktop"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="720"
        x:Class="Messa.Desktop.MainWindow"
        Title="MESSA - Double Ratchet Native Messenger"
        Width="1000" Height="740"
        WindowStartupLocation="CenterScreen"
        Background="#0E121A">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20">
        <!-- Top Navigation / Connection Bar -->
        <Border Grid.Row="0" Background="#161C26" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ MESSA" FontSize="20" FontWeight="Bold" Foreground="#4A90E2"/>
                    <TextBlock Text="Signal Double Ratchet • ECDSA • Native Skia" FontSize="12" VerticalAlignment="Center" Foreground="#7A889B"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF4D4D"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#7A889B" VerticalAlignment="Center"/>
                    <TextBox x:Name="ServerUrlBox" Text="wss://fotowaqu.ru" Width="190" VerticalAlignment="Center"/>
                    <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnectClicked" Background="#2B5278" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Identity & Profile Bar -->
        <Border Grid.Row="1" Background="#161C26" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto, 160, Auto, *, Auto">
                <TextBlock Text="Username:" FontWeight="SemiBold" Foreground="#A0AAB8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="UsernameBox" Watermark="e.g. alice" Margin="0,0,14,0"/>

                <TextBlock Grid.Column="2" Text="Fingerprint:" FontWeight="SemiBold" Foreground="#A0AAB8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" x:Name="MyFingerprintBox" IsReadOnly="True" Background="#0E121A" Foreground="#64B5F6" FontFamily="Consolas, monospace" FontSize="12"/>

                <Button Grid.Column="4" Content="Publish to Directory" Click="OnPublishProfileClicked" Margin="10,0,0,0" Background="#1E3A5F" Foreground="#64B5F6"/>
            </Grid>
        </Border>

        <!-- Recipient Lookup & Session Init (No more manual Base64 copy-paste!) -->
        <Border Grid.Row="2" Background="#161C26" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <TextBlock Text="Start Chat:" FontWeight="SemiBold" Foreground="#A0AAB8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="PeerSearchBox" Watermark="Enter @username or 64-char fingerprint (e.g. @bob)" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="Find &amp; Init Ratchet" Click="OnInitRatchetClicked" Background="#3B82F6" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" x:Name="ActivePeerLabel" Text="No active contact" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Border Grid.Row="3" Background="#161C26" CornerRadius="10" Padding="14">
            <ListBox x:Name="MessagesList" Background="#0E121A" CornerRadius="8" Padding="10">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatMessage">
                        <Border Background="{Binding BackgroundColor}" CornerRadius="8" Padding="12" Margin="4,4,4,4" MaxWidth="640" HorizontalAlignment="{Binding Alignment}">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding Header}" FontSize="11" Foreground="#93C5FD" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontSize="10" Foreground="#34D399" Margin="10,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding Text}" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Input Bar -->
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto" Margin="0,12,0,0">
            <TextBox Grid.Column="0" x:Name="MessageInputBox" Watermark="Type message (protected with Double Ratchet + ECDSA Signature)..." Height="44" VerticalContentAlignment="Center" KeyDown="OnMessageInputKeyDown"/>
            <Button Grid.Column="1" Content="Send Securely" Click="OnSendClicked" Background="#4A90E2" Foreground="White" FontWeight="Bold" Margin="10,0,0,0" Height="44" Padding="24,0"/>
        </Grid>
    </Grid>
</Window>
